# UBI base avoids Docker Hub unauthenticated pull rate limits on OpenShift builds
FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0

WORKDIR /app

COPY shared/ /app/shared/
RUN pip install --no-cache-dir /app/shared/

COPY acp-writer/pyproject.toml .
COPY acp-writer/src/ src/

RUN pip install --no-cache-dir .

# Bake sample CPG data so it auto-seeds on startup (SAMPLE_DATA_ROOT).
COPY shared/tests/fixtures/ /app/sample-data/shared/tests/fixtures/
COPY cpg-ingester/data/golden/ /app/sample-data/cpg-ingester/data/golden/
# Sample patient bundles for the UI's "sample patient" buttons.
COPY mock-EHR/data/ /app/sample-data/mock-EHR/data/
ENV SAMPLE_DATA_ROOT=/app/sample-data

RUN chmod -R g=u /app

USER 1001

EXPOSE 8082

CMD ["uvicorn", "acp_writer.api:app", "--host", "0.0.0.0", "--port", "8082"]
