<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/"
             xmlns:feel="https://www.omg.org/spec/DMN/20211108/FEEL/"
             id="definitions_ldl_lowering_risk_category_assignment"
             name="LDL-Lowering Risk Category Assignment"
             namespace="https://www.omg.org/spec/DMN/20211108/MODEL/">

  <inputData id="input_established_chd" name="Established CHD">
    <variable id="var_established_chd" name="Established CHD" typeRef="boolean"/>
  </inputData>

  <inputData id="input_other_clinical_atherosclerotic_disease" name="Other Clinical Atherosclerotic Disease">
    <variable id="var_other_clinical_atherosclerotic_disease" name="Other Clinical Atherosclerotic Disease" typeRef="boolean"/>
  </inputData>

  <inputData id="input_diabetes" name="Diabetes">
    <variable id="var_diabetes" name="Diabetes" typeRef="boolean"/>
  </inputData>

  <inputData id="input_adjusted_major_risk_factor_count" name="Adjusted Major Risk-Factor Count">
    <variable id="var_adjusted_major_risk_factor_count" name="Adjusted Major Risk-Factor Count" typeRef="number"/>
  </inputData>

  <inputData id="input_ten_year_chd_risk" name="Ten-Year CHD Risk">
    <variable id="var_ten_year_chd_risk" name="Ten-Year CHD Risk" typeRef="number"/>
  </inputData>

  <decision id="decision_ldl_lowering_risk_category_assignment" name="LDL-Lowering Risk Category Assignment">
    <description>Assigns a patient to a coronary heart disease risk category and corresponding LDL cholesterol goal.</description>
    <variable id="var_decision_ldl_lowering_risk_category_assignment" name="LDL-Lowering Risk Category Assignment"/>

    <informationRequirement id="ir_established_chd">
      <requiredInput href="#input_established_chd"/>
    </informationRequirement>

    <informationRequirement id="ir_other_clinical_atherosclerotic_disease">
      <requiredInput href="#input_other_clinical_atherosclerotic_disease"/>
    </informationRequirement>

    <informationRequirement id="ir_diabetes">
      <requiredInput href="#input_diabetes"/>
    </informationRequirement>

    <informationRequirement id="ir_adjusted_major_risk_factor_count">
      <requiredInput href="#input_adjusted_major_risk_factor_count"/>
    </informationRequirement>

    <informationRequirement id="ir_ten_year_chd_risk">
      <requiredInput href="#input_ten_year_chd_risk"/>
    </informationRequirement>

    <decisionTable id="dt_ldl_lowering_risk_category_assignment" hitPolicy="FIRST" preferredOrientation="Rule-as-Row">
      <input id="inp_established_chd">
        <inputExpression id="ie_established_chd" typeRef="boolean">
          <text><![CDATA[Established CHD]]></text>
        </inputExpression>
      </input>

      <input id="inp_other_clinical_atherosclerotic_disease">
        <inputExpression id="ie_other_clinical_atherosclerotic_disease" typeRef="boolean">
          <text><![CDATA[Other Clinical Atherosclerotic Disease]]></text>
        </inputExpression>
      </input>

      <input id="inp_diabetes">
        <inputExpression id="ie_diabetes" typeRef="boolean">
          <text><![CDATA[Diabetes]]></text>
        </inputExpression>
      </input>

      <input id="inp_adjusted_major_risk_factor_count">
        <inputExpression id="ie_adjusted_major_risk_factor_count" typeRef="number">
          <text><![CDATA[Adjusted Major Risk-Factor Count]]></text>
        </inputExpression>
      </input>

      <input id="inp_ten_year_chd_risk">
        <inputExpression id="ie_ten_year_chd_risk" typeRef="number">
          <text><![CDATA[Ten-Year CHD Risk]]></text>
        </inputExpression>
      </input>

      <output id="out_risk_category" name="Risk category" typeRef="string"/>
      <output id="out_ldl_goal" name="LDL goal" typeRef="string"/>

      <rule id="rule_established_chd">
        <description>Established coronary heart disease is a CHD risk equivalent.</description>
        <inputEntry id="ie_rule_established_chd_1"><text><![CDATA[true]]></text></inputEntry>
        <inputEntry id="ie_rule_established_chd_2"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rule_established_chd_3"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rule_established_chd_4"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rule_established_chd_5"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rule_established_chd_1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry>
        <outputEntry id="oe_rule_established_chd_2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry>
      </rule>

      <rule id="rule_other_atherosclerotic_disease">
        <description>Other clinical atherosclerotic disease is a CHD risk equivalent.</description>
        <inputEntry id="ie_rule_other_atherosclerotic_disease_1"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_other_atherosclerotic_disease_2"><text><![CDATA[true]]></text></inputEntry>
        <inputEntry id="ie_rule_other_atherosclerotic_disease_3"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rule_other_atherosclerotic_disease_4"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rule_other_atherosclerotic_disease_5"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rule_other_atherosclerotic_disease_1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry>
        <outputEntry id="oe_rule_other_atherosclerotic_disease_2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry>
      </rule>

      <rule id="rule_diabetes">
        <description>Diabetes is a CHD risk equivalent.</description>
        <inputEntry id="ie_rule_diabetes_1"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_diabetes_2"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_diabetes_3"><text><![CDATA[true]]></text></inputEntry>
        <inputEntry id="ie_rule_diabetes_4"><text><![CDATA[-]]></text></inputEntry>
        <inputEntry id="ie_rule_diabetes_5"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rule_diabetes_1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry>
        <outputEntry id="oe_rule_diabetes_2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry>
      </rule>

      <rule id="rule_high_ten_year_risk">
        <description>Two or more risk factors with greater than 20 percent 10-year CHD risk is a CHD risk equivalent.</description>
        <inputEntry id="ie_rule_high_ten_year_risk_1"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_high_ten_year_risk_2"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_high_ten_year_risk_3"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_high_ten_year_risk_4"><text><![CDATA[>= 2]]></text></inputEntry>
        <inputEntry id="ie_rule_high_ten_year_risk_5"><text><![CDATA[> 20]]></text></inputEntry>
        <outputEntry id="oe_rule_high_ten_year_risk_1"><text><![CDATA["CHD/CHD risk equivalent"]]></text></outputEntry>
        <outputEntry id="oe_rule_high_ten_year_risk_2"><text><![CDATA["<100 mg/dL"]]></text></outputEntry>
      </rule>

      <rule id="rule_intermediate_risk">
        <description>Two or more risk factors with 10 to 20 percent 10-year CHD risk.</description>
        <inputEntry id="ie_rule_intermediate_risk_1"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_intermediate_risk_2"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_intermediate_risk_3"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_intermediate_risk_4"><text><![CDATA[>= 2]]></text></inputEntry>
        <inputEntry id="ie_rule_intermediate_risk_5"><text><![CDATA[[10..20]]]></text></inputEntry>
        <outputEntry id="oe_rule_intermediate_risk_1"><text><![CDATA["2+ risk factors with 10-year risk 10-20%"]]></text></outputEntry>
        <outputEntry id="oe_rule_intermediate_risk_2"><text><![CDATA["<130 mg/dL"]]></text></outputEntry>
      </rule>

      <rule id="rule_lower_risk">
        <description>Two or more risk factors with less than 10 percent 10-year CHD risk.</description>
        <inputEntry id="ie_rule_lower_risk_1"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_lower_risk_2"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_lower_risk_3"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_lower_risk_4"><text><![CDATA[>= 2]]></text></inputEntry>
        <inputEntry id="ie_rule_lower_risk_5"><text><![CDATA[< 10]]></text></inputEntry>
        <outputEntry id="oe_rule_lower_risk_1"><text><![CDATA["2+ risk factors with 10-year risk <10%"]]></text></outputEntry>
        <outputEntry id="oe_rule_lower_risk_2"><text><![CDATA["<130 mg/dL"]]></text></outputEntry>
      </rule>

      <rule id="rule_zero_to_one_risk_factor">
        <description>Zero or one major risk factor without CHD, clinical atherosclerotic disease, or diabetes.</description>
        <inputEntry id="ie_rule_zero_to_one_risk_factor_1"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_zero_to_one_risk_factor_2"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_zero_to_one_risk_factor_3"><text><![CDATA[false]]></text></inputEntry>
        <inputEntry id="ie_rule_zero_to_one_risk_factor_4"><text><![CDATA[<= 1]]></text></inputEntry>
        <inputEntry id="ie_rule_zero_to_one_risk_factor_5"><text><![CDATA[-]]></text></inputEntry>
        <outputEntry id="oe_rule_zero_to_one_risk_factor_1"><text><![CDATA["0-1 risk factor"]]></text></outputEntry>
        <outputEntry id="oe_rule_zero_to_one_risk_factor_2"><text><![CDATA["<160 mg/dL"]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>